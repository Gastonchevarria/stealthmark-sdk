{
  "name": "@stealthmark/cli",
  "version": "0.1.2",
  "description": "CLI that scaffolds StealthMark middleware for Next.js, Express and Fastify and checks whether a site serves a StealthMark agent manifest",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "stealthmark": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && chmod +x dist/bin.js",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo"
  },
  "keywords": [
    "stealthmark",
    "cli",
    "ai-agents",
    "agent-manifest",
    "scaffold"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gastonchevarria/stealthmark-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://stealthmark.io",
  "engines": {
    "node": ">=20"
  },
  "author": "Gaston Chevarria <gaston_ch27@hotmail.com>",
  "dependencies": {
    "@stealthmark/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "bugs": {
    "url": "https://github.com/Gastonchevarria/stealthmark-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
